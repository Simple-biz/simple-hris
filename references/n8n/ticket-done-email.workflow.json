      "parameters": {
        "sendTo": "={{ $json.body.send_to }}",
        "subject": "=✅ Done — Ticket #{{ $json.body.ticket_no }}: {{ $json.body.title }} is ready to test",
        "message": "=<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f4f5;padding:24px 12px\">\n  <tr><td align=\"center\">\n    <table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:560px;background:#ffffff;border:1px solid #e4e4e7;border-radius:12px;font-family:Arial,Helvetica,sans-serif\">\n      <tr>\n        <td style=\"padding:16px 24px 14px\"><img src=\"https://simple-hris.vercel.app/simple-logo.png\" alt=\"Simple\" width=\"82\" height=\"28\" style=\"display:block;border:0\"></td>\n      </tr>\n      <tr>\n        <td bgcolor=\"#0a0a0b\" style=\"background:#0a0a0b;padding:20px 24px;border-bottom:3px solid #059669\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n            <tr>\n              <td style=\"font-size:11px;letter-spacing:2px;color:#a1a1aa;text-transform:uppercase;font-weight:bold\">Simple HRIS &middot; Updates board</td>\n              <td align=\"right\"><span style=\"display:inline-block;background:#059669;color:#ffffff;font-size:11px;font-weight:bold;letter-spacing:1px;padding:4px 10px;border-radius:20px\">DONE</span></td>\n            </tr>\n          </table>\n          <div style=\"margin-top:14px;font-size:20px;line-height:1.35;color:#ffffff;font-weight:bold\"><span style=\"color:#34d399\">#{{ $json.body.ticket_no }}</span>&nbsp;&nbsp;{{ $json.body.title }}</div>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:20px 24px 0;font-size:14px;line-height:1.6;color:#27272a\">\n          Hi {{ $json.body.creator_name }},<br><br>\n          Good news &mdash; your request just moved to <b>Done</b>. <b>Refresh the HRIS and test the feature out.</b>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:16px 24px 0\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-size:13px;color:#18181b\">\n            <tr>\n              <td width=\"110\" style=\"padding:7px 0;color:#71717a\">Priority</td>\n              <td style=\"padding:7px 0\">{{ $json.body.priority_label }}</td>\n            </tr>\n            <tr>\n              <td width=\"110\" style=\"padding:7px 0;color:#71717a;border-top:1px solid #f4f4f5\">Completed</td>\n              <td style=\"padding:7px 0;border-top:1px solid #f4f4f5\">{{ DateTime.fromISO($json.body.done_at).setZone('Asia/Manila').toFormat('MMM d, yyyy &middot; h:mm a') }} (Manila)</td>\n            </tr>\n            <tr>\n              <td width=\"110\" style=\"padding:7px 0;color:#71717a;border-top:1px solid #f4f4f5\">Moved by</td>\n              <td style=\"padding:7px 0;border-top:1px solid #f4f4f5\">{{ $json.body.moved_by }}</td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:18px 24px 0;font-size:13px;line-height:1.6;color:#71717a\">Something not looking right? Open the ticket and leave a reply on its <b style=\"color:#27272a\">Updates</b> thread &mdash; we'll pick it back up.</td>\n      </tr>\n      <tr>\n        <td style=\"padding:20px 24px 8px\">\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\">\n            <tr>\n              <td bgcolor=\"#059669\" style=\"background:#059669;border-radius:8px\">\n                <a href=\"{{ $json.body.ticket_url || $json.body.board_url }}\" style=\"display:inline-block;padding:12px 22px;color:#ffffff;font-size:14px;font-weight:bold;text-decoration:none\">Open ticket #{{ $json.body.ticket_no }} &rarr;</a>\n              </td>\n            </tr>\n          </table>\n          <div style=\"margin-top:10px;font-size:12px;color:#a1a1aa;word-break:break-all\">Button not working? {{ $json.body.ticket_url || $json.body.board_url }}</div>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:14px 24px 16px;border-top:1px solid #f4f4f5;font-size:12px;color:#a1a1aa\">You're getting this because you filed this ticket on the HRIS Updates board.</td>\n      </tr>\n    </table>\n  </td></tr>\n</table>",
        "options": {}
      },
