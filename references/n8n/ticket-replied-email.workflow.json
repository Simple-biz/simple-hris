      "name": "Ticket Replied (from HRIS)",
      "webhookId": "hris-ticket-replied"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.send_to }}",
        "subject": "=💬 New reply on Ticket #{{ $json.body.ticket_no }}: {{ $json.body.title }}",
        "message": "=<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f4f5;padding:24px 12px\">\n  <tr><td align=\"center\">\n    <table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:560px;background:#ffffff;border:1px solid #e4e4e7;border-radius:12px;font-family:Arial,Helvetica,sans-serif\">\n      <tr>\n        <td style=\"padding:16px 24px 14px\"><img src=\"https://simple-hris.vercel.app/simple-logo.png\" alt=\"Simple\" width=\"82\" height=\"28\" style=\"display:block;border:0\"></td>\n      </tr>\n      <tr>\n        <td bgcolor=\"#0a0a0b\" style=\"background:#0a0a0b;padding:20px 24px;border-bottom:3px solid #dc2626\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n            <tr>\n              <td style=\"font-size:11px;letter-spacing:2px;color:#a1a1aa;text-transform:uppercase;font-weight:bold\">Simple HRIS &middot; Updates board</td>\n              <td align=\"right\"><span style=\"display:inline-block;background:#dc2626;color:#ffffff;font-size:11px;font-weight:bold;letter-spacing:1px;padding:4px 10px;border-radius:20px\">NEW REPLY</span></td>\n            </tr>\n          </table>\n          <div style=\"margin-top:14px;font-size:20px;line-height:1.35;color:#ffffff;font-weight:bold\"><span style=\"color:#f87171\">#{{ $json.body.ticket_no }}</span>&nbsp;&nbsp;{{ $json.body.title }}</div>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:20px 24px 0;font-size:14px;line-height:1.6;color:#27272a\">\n          Hi {{ $json.body.recipient_name }},<br><br>\n          {{ $json.body.replier_name }} just replied on {{ $json.body.recipient_is_creator ? \"your ticket\" : \"a ticket assigned to you\" }}.\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:16px 24px 0\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fafafa;border:1px solid #e4e4e7;border-left:3px solid #dc2626;border-radius:6px\">\n            <tr><td style=\"padding:14px 16px;font-size:14px;line-height:1.6;color:#27272a;white-space:pre-wrap\">{{ $json.body.comment_body }}</td></tr>\n          </table>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:16px 24px 0\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-size:13px;color:#18181b\">\n            <tr>\n              <td width=\"110\" style=\"padding:7px 0;color:#71717a\">From</td>\n              <td style=\"padding:7px 0\">{{ $json.body.replier_name }}</td>\n            </tr>\n            <tr>\n              <td width=\"110\" style=\"padding:7px 0;color:#71717a;border-top:1px solid #f4f4f5\">Ticket status</td>\n              <td style=\"padding:7px 0;border-top:1px solid #f4f4f5\">{{ $json.body.status_label }}</td>\n            </tr>\n            <tr>\n              <td width=\"110\" style=\"padding:7px 0;color:#71717a;border-top:1px solid #f4f4f5\">Priority</td>\n              <td style=\"padding:7px 0;border-top:1px solid #f4f4f5\">{{ $json.body.priority_label }}</td>\n            </tr>\n            <tr>\n              <td width=\"110\" style=\"padding:7px 0;color:#71717a;border-top:1px solid #f4f4f5\">Replied</td>\n              <td style=\"padding:7px 0;border-top:1px solid #f4f4f5\">{{ DateTime.fromISO($json.body.replied_at).setZone('Asia/Manila').toFormat('MMM d, yyyy &middot; h:mm a') }} (Manila)</td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:18px 24px 0;font-size:13px;line-height:1.6;color:#71717a\">Reply on the ticket's <b style=\"color:#27272a\">Updates</b> thread to keep it all in one place &mdash; email replies do not reach the board.</td>\n      </tr>\n\n      <tr>\n        <td style=\"padding:20px 24px 8px\">\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\">\n            <tr>\n              <td bgcolor=\"#dc2626\" style=\"background:#dc2626;border-radius:8px\">\n                <a href=\"{{ $json.body.ticket_url || $json.body.board_url }}\" style=\"display:inline-block;padding:12px 22px;color:#ffffff;font-size:14px;font-weight:bold;text-decoration:none\">Open ticket #{{ $json.body.ticket_no }} &rarr;</a>\n              </td>\n            </tr>\n          </table>\n          <div style=\"margin-top:10px;font-size:12px;color:#a1a1aa;word-break:break-all\">Button not working? {{ $json.body.ticket_url || $json.body.board_url }}</div>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:14px 24px 16px;border-top:1px solid #f4f4f5;font-size:12px;color:#a1a1aa\">You're getting this because you {{ $json.body.recipient_is_creator ? \"filed this ticket\" : \"are the developer assigned to it\" }} on the HRIS Updates board.</td>\n      </tr>\n    </table>\n  </td></tr>\n</table>",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
