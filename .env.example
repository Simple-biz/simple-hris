# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Table to list on Overview (default: global_master_list)
# Expected columns: Department, Name, Personal Email, Work Email, Start Date; optional Profile Photo URL.
# Bulk CSV replace (full table): POST /api/global-master-list with FormData file — requires SUPABASE_SERVICE_ROLE_KEY
# and a bigint `id` primary key on the table (see references/supabase_global_master_list.sql).
NEXT_PUBLIC_SUPABASE_EMPLOYEES_TABLE="global_master_list"

# Payroll Wizard — rows from Supabase (default: hubstaff_hours)
# Map columns like Email, Member, Job type, Total worked (see src/lib/supabase/hubstaff-hours.ts)
NEXT_PUBLIC_SUPABASE_HUBSTAFF_HOURS_TABLE="hubstaff_hours"

# Initial Calculation — hourly rates (default: employee_hourly_rates)
# Expected columns include Work Email, Regular Rate, OT Rate (see src/lib/supabase/employee-hourly-rates.ts)
NEXT_PUBLIC_SUPABASE_EMPLOYEE_HOURLY_RATES_TABLE="employee_hourly_rates"

# Rates tab — merge extra tables into each profile modal (server-only, comma-separated).
# If unset: with DATABASE_URL, all public.base tables are merged; otherwise rates + master + hubstaff_hours.
# SUPABASE_PROFILE_TABLES=hubstaff_hours,other_table

# Optional: exclude public tables when auto-discovering (comma-separated).
# SUPABASE_PROFILE_TABLES_EXCLUDE=some_large_table

# Direct Postgres URL (Settings → Database) — enables listing all public tables for profile merge. Server-only.
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Payroll Wizard — service_role (server-only): replacing hubstaff_hours; reading employee_hourly_rates if RLS blocks anon.
# Supabase → Project Settings → API → service_role (the secret key, NOT the anon key).
# Never prefix with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Google SSO (NextAuth) ─────────────────────────────────────────────────────
# OAuth 2.0 Client created in the company GCP project (Web application type).
# Redirect URIs registered on the Google side:
#   https://simple-hris.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-YOUR_CLIENT_SECRET"

# Session encryption key — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be identical across all deployments that share session cookies.
NEXTAUTH_SECRET="YOUR_RANDOM_BASE64_SECRET"

# Canonical URL NextAuth uses to build callback links.
# Local: http://localhost:3000   ·   Prod on Vercel: https://simple-hris.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── Super-admin impersonation (TEMPORARY backdoor) ────────────────────────────
# A second sign-in path on /login: enter any @simple.biz email + this password and
# you are signed in AS that account (same roles, dashboards, and data they'd see).
# Lets an admin step into any perspective in HRIS. This is a master key — treat it
# as one. Every use is written to audit_log (action auth.impersonation.signin).
#   SUPER_ADMIN_PASSWORD          shared password (default "super-admin" if unset).
#   SUPER_ADMIN_IMPERSONATION=off removes the backdoor entirely (recommended for
#                                 production once the real verification flow ships).
SUPER_ADMIN_PASSWORD="super-admin"
# SUPER_ADMIN_IMPERSONATION="off"

# ── Google Workspace service account ──────────────────────────────────────────
# JWT-bearer service account used for Sheets sync and the live license count.
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL="svc-acct@your-project.iam.gserviceaccount.com"
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Sheet sync targets (id = the part between /d/ and /edit; tab = the gid's name) ─
# Master list sync (Global Master List tab) — read by src/lib/google-sheets/fetch-master-sheet.ts
# GOOGLE_SHEETS_MASTER_SHEET_ID="..."
# GOOGLE_SHEETS_MASTER_TAB_NAME="MASTERLIST"
# Screening sync ("Screenings 2.0" sheet → HR Screening tab) — the service account
# above must have at least Viewer access to this sheet.
GOOGLE_SHEETS_SCREENING_SHEET_ID="1eMJHKpE-TZwAyZmVl23DX6Frh6yO0qAVSA8lG8UygCU"
GOOGLE_SHEETS_SCREENING_TAB_NAME="Screenings2.0"

# ── Live Workspace license count (optional) ───────────────────────────────────
# Enables auto-counting ASSIGNED licenses via the Enterprise License Manager API.
# Requires the service account's client ID to be authorized for the
# https://www.googleapis.com/auth/apps.licensing scope in Admin Console >
# Security > API Controls > Domain-wide Delegation.
# GOOGLE_WORKSPACE_ADMIN_EMAIL must be a super-admin to impersonate.
GOOGLE_WORKSPACE_ADMIN_EMAIL="admin@simple.biz"
# Optional overrides — default customerId = admin email domain; product = Google-Apps.
# GOOGLE_WORKSPACE_CUSTOMER_ID="simple.biz"
# GOOGLE_WORKSPACE_PRODUCT_ID="Google-Apps"

# ── CEO assistant (Claude) ────────────────────────────────────────────────────
# Powers the floating chat bubble on the CEO dashboard (/api/ceo/chat).
# Anthropic API key from https://console.anthropic.com — uses claude-sonnet-4-6.
# Without it, the assistant returns a "not configured" message.
ANTHROPIC_API_KEY="sk-ant-..."

# ── Hubstaff live API sync (Payroll Wizard → "Sync from Hubstaff") ────────────
# HUBSTAFF_PAT: Personal Access Token from https://developer.hubstaff.com/personal_access_tokens
# (create with read scopes). NOTE: this is an OAuth REFRESH token, not a bearer token —
# the server exchanges it for short-lived access tokens and persists the rotated chain
# in app_settings (key hubstaff.api.token). Valid 90 days from last use; rotate here
# and in deployment settings if it expires or is compromised. Server-only.
HUBSTAFF_PAT="YOUR_HUBSTAFF_PERSONAL_ACCESS_TOKEN"
# Numeric organization id — visible in the app.hubstaff.com URL. (The n8n invite
# webhook in src/lib/hr/hubstaff-invite.ts uses org 724122 for simple.biz.)
HUBSTAFF_ORG_ID="724122"
# Shows the "Sync from Hubstaff" button in the Payroll Wizard's Upload step. Leave
# unset/false on environments without credentials — CSV upload always still works.
NEXT_PUBLIC_HUBSTAFF_API_ENABLED="true"

# Tickets board (/tickets) — n8n webhook fired when a ticket is created, so the
# admin gets an email with the request details. Preferred setup: Admin → Webhooks
# entry with slug `ticket_created`; this env var is the fallback.
# N8N_TICKETS_WEBHOOK_URL="https://your-n8n-host/webhook/hris-ticket-created"

# Tickets board — n8n webhook fired when a ticket is moved into Done; the n8n
# side emails the ticket's creator that they can refresh the HRIS and test.
# Preferred setup: Admin → Webhooks entry with slug `ticket_done`; env fallback:
# N8N_TICKETS_DONE_WEBHOOK_URL="https://your-n8n-host/webhook/hris-ticket-done"
